         return cpp_ext
 
@@ -36,5 +37,9 @@ class CPUOpBuilder(OpBuilder):
         args += [CPU_ARCH, '-fopenmp', SIMD_WIDTH]
         return args
 
+    def extra_ldflags(self):
+        # The CPU ops are compiled with -fopenmp, so link the OpenMP runtime too
+        return ['-fopenmp']
+
     def libraries_args(self):
         return []
